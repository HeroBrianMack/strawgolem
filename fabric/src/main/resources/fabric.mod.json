{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${authors}"
    ],
    "contact": {
        "homepage": "https://www.curseforge.com/minecraft/mc-mods/strawgolem-reborn",
        "sources": "https://github.com/t2pellet/strawgolem"
    },
    "license": "${license}",
    "icon": "assets/strawgolem/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.t2pellet.strawgolem.StrawgolemFabric"
        ],
        "client": [
            "com.t2pellet.strawgolem.StrawgolemFabric"
        ],
        "jade": [
            "com.t2pellet.strawgolem.compat.jade.StrawgolemJadePlugin"
        ]
    },
    "mixins": [
        "strawgolem.mixins.json",
        "strawgolem.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_min}",
        "fabric": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=17",
        "haybalelib": "*",
        "geckolib": "*"
    },
    "suggests": {
        "modmenu": "*",
        "cloth-config": "*",
        "jade": "*",
        "animal_feeding_trough": "*"
    }
}
  